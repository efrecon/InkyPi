[Unit]
Description=InkyPi App
After=network-online.target
Wants=network-online.target

[Service]
User=root
Type=simple
#WorkingDirectory=~
Environment="INKYPI_ROOTDIR=/home/emmanuel/InkyPi"
ExecStart=/usr/local/bin/inkypi.sh
Restart=on-failure
RestartSec=60
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal
CPUQuota=40%
MemoryMax=200M

[Install]
WantedBy=multi-user.target
